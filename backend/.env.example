# LastPlate Backend Configuration
DATABASE_URL=sqlite:///./lastplate.db
KG_PER_PORTION=0.45

# AWS Strands Agents SDK & AI Provider Configuration
# Options: "mock" (offline rule engine), "ollama" (local LLM), "bedrock" (AWS Bedrock), "openai"
MODEL_PROVIDER=mock

# Local Ollama Settings (Optional, for offline local LLMs)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# AWS Bedrock Settings (Optional, when using AWS Bedrock credentials)
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Hosted Provider Keys (Optional, keep secrets secure)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
